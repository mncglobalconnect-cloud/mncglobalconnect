# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""
# Database that holds all application data.
MONGODB_DB="mnc_global_connect"

# Base URL used in password set-up links printed by the admin scripts.
APP_URL="http://localhost:3000"

# Browser-visible key: restrict by HTTP referrer and permitted APIs in Google Cloud.
# Enable Maps JavaScript API, Places API (New), and Maps Embed API, with billing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
